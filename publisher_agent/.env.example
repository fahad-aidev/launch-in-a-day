# Publisher-only secrets. Copy to publisher_agent/.env and fill in real values.
# Only the Publisher process reads this file. It is git-ignored.

# Fine-grained token: only your demo repo, permission "Contents: Read and write".
GITHUB_TOKEN=paste-your-fine-grained-token-here

# The demo repo as owner/name, e.g. my-username/launch-demo
GITHUB_REPO=your-username/your-demo-repo
