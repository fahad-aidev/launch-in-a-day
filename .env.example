# Template only. Copy it to .env and put your real values in .env (never in this file).
# .env is listed in .gitignore, so it can never be committed.

# Use the free Gemini Developer API (Google AI Studio key), not Google Cloud.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste-your-key-here

# The model the Director, Brand and Publisher use. `python check_setup.py --try` checks it.
MODEL=gemini-3.5-flash-lite

# The Builder has the hardest job (designing the page), so it gets the strongest free model.
BUILDER_MODEL=gemini-4-hydrogen
